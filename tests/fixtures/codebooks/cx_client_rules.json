{
  "_about": "The client CX rules (job-role group, products, drivers, score flags) expressed as codebook edits instead of code. Applied to tests/fixtures/exports/hubspot_cx_sample.xlsx. Open questions with the client's analysts (Programmes AND/OR exams, Triple with Other, Not applicable as a product) are marked in _note fields.",
  "edits": [
    {"op": "add_derived", "derived": {
      "name": "Role_group", "label": "Job role group", "rule": "priority", "after": "Job_role_Other",
      "params": {
        "base": "Job role",
        "groups": [
          {"code": 1, "label": "Exams Officer", "when": {"var": "Job role", "any": ["Exams Officer"]}},
          {"code": 2, "label": "Leader", "when": {"or": [
            {"var": "Job role", "any": ["School Leader", "School Group/School District Leader"]},
            {"and": [{"var": "Job role", "any": ["Head of Department"]}, {"var": "Job role", "none": ["Teacher"]}]}
          ]}},
          {"code": 3, "label": "Teacher", "when": {"var": "Job role", "any": ["Teacher"]}}
        ],
        "else": {"code": 4, "label": "Other"}
      }}},
    {"op": "add_derived", "derived": {
      "name": "Product_count", "label": "Number of products", "rule": "count",
      "params": {
        "from": "Customer type",
        "_note": "Every listed answer counts (incl. Other / Not applicable), as the analysts' LEN formula does — open question",
        "bands": [
          {"code": 1, "label": "Single product", "min": 1, "max": 1},
          {"code": 2, "label": "Dual product", "min": 2, "max": 2},
          {"code": 3, "label": "Triple product", "min": 3, "max": null}
        ]
      }}},
    {"op": "add_derived", "derived": {
      "name": "Product_mix", "label": "Product mix", "rule": "combination",
      "params": {
        "from": "Customer type",
        "combos": [
          {"code": 1, "label": "Resources only", "exact": ["Teaching and learning resources such as textbooks, digital tools, or curriculum support"]},
          {"code": 2, "label": "Programmes only", "exact": ["Programmes or curriculum"]},
          {"code": 3, "label": "Exams only", "exact": ["Exams or qualifications"]},
          {"code": 4, "label": "Resources + Programmes", "exact": ["Teaching and learning resources such as textbooks, digital tools, or curriculum support", "Programmes or curriculum"]},
          {"code": 5, "label": "Programmes + Exams", "exact": ["Programmes or curriculum", "Exams or qualifications"]},
          {"code": 6, "label": "Resources + Exams", "exact": ["Teaching and learning resources such as textbooks, digital tools, or curriculum support", "Exams or qualifications"]}
        ]
      }}},
    {"op": "add_derived", "derived": {
      "name": "Programmes_or_exams", "label": "Programmes AND/OR exams", "rule": "combination",
      "params": {
        "from": "Customer type",
        "_note": "Our reading: Programmes and/or Exams but no Resources — open question with the analysts",
        "combos": [{"code": 1, "label": "Programmes and/or exams", "within": ["Programmes or curriculum", "Exams or qualifications"]}]
      }}},
    {"op": "add_derived", "derived": {
      "name": "DRIVERS", "label": "Drivers", "rule": "coalesce",
      "params": {"from": ["Detractors Drivers", "Passive Drivers", "Promoter Drivers"]}}},
    {"op": "add_derived", "derived": {
      "name": "Ease_score", "label": "CX Principle - Ease score", "rule": "flags",
      "params": {"from": "CX_Principle_Ease"}}}
  ]
}
